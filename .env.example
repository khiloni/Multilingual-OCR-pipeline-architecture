# DocScribe - Environment Configuration Template
# Purpose: Configuration variables for Postgres, Redis, MinIO, and Celery.
# Future TODOs: Add OAuth2 client variables, API rate limit configurations, and custom fallback threshold configurations.

# --- API Config ---
PORT=8000
HOST=0.0.0.0
DEBUG=true

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=docscribe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cache & Task Broker (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docscribe-storage
MINIO_SECURE=false

# --- OCR Processing ---
PADDLE_CONFIDENCE_THRESHOLD=0.85
SURYA_CONFIDENCE_THRESHOLD=0.75
ENABLE_SURYA_FALLBACK=true
ENABLE_IMAGE_VARIANT_RETRY=true
IMAGE_VARIANT_MAX_ATTEMPTS=2

# --- API-based OCR/spell correction (OFF by default) ---
# Document text is sent to this provider's API for correction when enabled —
# see the README "Privacy" note before turning this on for sensitive documents.
# provider: anthropic | openai | gemini | legacy_symspell | none (none = raw OCR text, no correction, default)
CORRECTION_PROVIDER=none
CORRECTION_API_KEY=
# Model examples per provider: anthropic -> claude-opus-5 | openai -> gpt-4o-mini | gemini -> gemini-3.8-flash
CORRECTION_MODEL=claude-opus-5
CORRECTION_TIMEOUT_SECONDS=30
CORRECTION_MAX_RETRIES=2
CORRECTION_SKIP_CONFIDENCE=0.98
CORRECTION_MAX_EDIT_DISTANCE_RATIO=0.30

# --- OCR quality score weights (must sum to 1.0) ---
QUALITY_WEIGHT_CONFIDENCE=0.35
QUALITY_WEIGHT_TEXT_QUALITY=0.25
QUALITY_WEIGHT_CHARACTER_QUALITY=0.15
QUALITY_WEIGHT_PAGE_COVERAGE=0.15
QUALITY_WEIGHT_LANGUAGE_CONSISTENCY=0.10
# Below this, a page is retried/escalated even if raw confidence alone cleared its threshold.
QUALITY_SCORE_THRESHOLD=0.70
